# Грубая оценка направления на источник звука по паре микрофонов —
# межканальная разница громкости (ILD), НЕ время прихода (TDOA/GCC-PHAT).
#
# История: изначально пробовали GCC-PHAT (TDOA), но на реальной голове
# InMoov оба капсюля MAX9814 акустически связаны через общую полость
# черепа (открытый скелет, сервоприводы, шея) — герметизация уха снижает
# утечку, но не убирает её полностью. Измеренная задержка регулярно
# превышала физически возможный максимум для базы между ушами — то есть
# измерялся не прямой путь звука, а переотражения внутри головы. TDOA
# оказался ненадёжен; разница громкости — единственный сигнал, который
# на реальных тестах (речь, 10с) давал стабильный результат: смещение в
# нужную сторону ~2.7-3.4дБ. См. project_sound_localization_gcc_phat.md.
#
# angle_deg НЕ физическая модель (не asin(tdoa*c/d)) — это линейное
# отображение ild_db в диапазон [-90..+90] с насыщением на max_ild_db
# (параметр ноды), просто для совместимости с потребителями топика,
# ожидающими угол. Точность — только "куда крен", не точный градус.
# Неустранимая неоднозначность спереди/сзади (как и у любой пары
# микрофонов): источник спереди и сзади под тем же углом неотличимы.

std_msgs/Header header

float32 angle_deg     # [-90..+90], + = источник справа, - = источник слева (грубо, не физическая модель)
float32 ild_db         # разница громкости, right относительно left, дБ; + = справа громче
float32 confidence     # 0..1, эвристика — насколько блок громче гейта
float32 rms_dbfs        # средняя громкость блока по обоим каналам, дБFS
bool voiced             # RMS блока прошёл энергетический гейт (не тишина/шум)
