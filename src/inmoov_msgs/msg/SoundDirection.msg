# Направление на источник звука по паре микрофонов — голосование по знаку
# TDOA (полосовой GCC-PHAT, 2-6кГц), НЕ ILD (громкость) и НЕ физический угол.
#
# История (см. project_sound_localization_gcc_phat.md):
# 1) Исходный широкополосный GCC-PHAT (без фильтра) — работал чисто на
#    открытом столе (±90°), но на установленной в уши голове давал
#    физически невозможные задержки (превышают предел c*d для базы между
#    ушами) — открытый скелет черепа (сервоприводы, провода, шея) даёт
#    внутреннюю утечку звука между капсюлями.
# 2) Пивот на ILD (межканальная разница громкости) — работал на близкой
#    дистанции (5-6см), но на реальной дистанции разговора (1-3м, комната
#    3x2.5м) деградировал почти до случайного знака — отражения в комнате
#    перебивают слабую разницу громкости от направления.
# 3) 2026-08-22: полосовой фильтр (2-6кГц, где утечка через полость слабее)
#    перед GCC-PHAT НЕ убрал избыточную задержку (всё ещё физически
#    невозможна), НО её ЗНАК стабильно коррелирует с реальным направлением,
#    и голосование большинства по знаку за скользящее окно блоков — рабочий
#    сигнал даже на 1-3м. Подтверждено вслепую (6/6 верных угадываний,
#    шипение и живая речь, дистанции 0.2-2м).
#
# angle_deg НЕ физический угол — это (голосов_право - голосов_лево) /
# всего_голосов_в_окне * 90°, то есть насколько уверенно большинство
# блоков в скользящем окне склоняется в одну сторону. Точность — только
# "куда крен", не градус. Неустранимая неоднозначность спереди/сзади (как
# и у любой пары микрофонов) — источник спереди и сзади под тем же углом
# неотличимы, разрешать через зрение (OAK-D/face_detection).

std_msgs/Header header

float32 angle_deg      # [-90..+90], + = источник справа (по голосованию), - = слева; НЕ физический угол
float32 tdoa_us         # медиана сырой (нефизичной, раздутой внутренней утечкой) задержки за окно, мкс; знак: + = право, - = лево; только для отладки
float32 confidence      # 0..1, |голосов_право - голосов_лево| / всего_голосов за скользящее окно
float32 rms_dbfs        # громкость последнего блока по обоим каналам, дБFS
bool voiced             # RMS последнего блока прошёл энергетический гейт (не тишина/шум)
