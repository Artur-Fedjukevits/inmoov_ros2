<?xml version="1.0"?>
<!-- Self-collision matrix for inmoov_i2.urdf.xacro (robot name "inmoov_i2",
     must match the URDF). Generated 2026-09-28 by scripts/selfcoll.py
     (20000 random poses, mimic Mid=0.8 Tip=0.6); entries chosen from its
     result by hand. Pairs NOT listed here must be checked.

     Author: Artur Fedjukevits
     Assisted by: Claude Code (Anthropic)
     License: GNU General Public License v3.0 (see repository root LICENSE) -->
