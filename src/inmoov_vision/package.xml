<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inmoov_vision</name>
  <version>0.1.0</version>
  <description>Vision pipeline for the InMoov robot — dual-eye face detection/tracking/recognition, emotion recognition, human detection, OAK-D spatial perception, and head-tracking control</description>
  <maintainer email="fedjukevitsh@gmail.com">Artur Fedjukevits</maintainer>
  <license>GPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>inmoov_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
