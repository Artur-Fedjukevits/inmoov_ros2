<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inmoov_cognition</name>
  <version>0.1.0</version>
  <description>Cognition layer for the InMoov robot — Behavior Tree (Data/Decision/Action), social context (IdentityManager), LLM-driven dialogue and tool calls, and bridges to openHAB and Telegram</description>
  <maintainer email="fedjukevitsh@gmail.com">Artur Fedjukevits</maintainer>
  <license>GPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <depend>inmoov_msgs</depend>
  <depend>inmoov_memory</depend>
  <exec_depend>python3-websocket</exec_depend>
  <depend>sensor_msgs</depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
