# Secrets for inmoov.service — copy to ~/inmoov.env (chmod 600) and fill in.
# Never commit the real file. systemd EnvironmentFile: no comments after values.

# bearer token of the vLLM (OpenAI-compatible) server
VLLM_BEARER_TOKEN=
# web_search tool (optional)
TAVILY_API_KEY=
# telegram_bridge_node (optional); the bot answers only TELEGRAM_ALLOWED_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# true = start telegram_bridge_node
INMOOV_TELEGRAM=false
